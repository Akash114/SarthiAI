# API base URL (optional). If unset, defaults are chosen in src/config.ts:
#   Android emulator → http://10.0.2.2:8000
#   iOS simulator    → http://127.0.0.1:8000
#
# Physical device on Wi‑Fi (backend on your laptop, same network):
EXPO_PUBLIC_API_URL=http://192.168.1.33:8000
# (Use your laptop's LAN IP; backend must listen on 0.0.0.0, e.g. uvicorn --host 0.0.0.0.)
#
# Physical device over USB (adb reverse tcp:8000 tcp:8000):
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Optional: set expo.extra.apiUrl in app.json instead of this file.
#
# Telemetry (Expo config extra in app.json):
#   posthogKey, posthogHost, sentryDsn
#
# After changing .env, restart Metro with cache clear: npx expo start --clear

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/Sarthi
REDIS_URL=redis://127.0.0.1:6379/0
ENVIRONMENT=staging

# Required
JWT_SECRET=replace-with-32-plus-char-random-secret

# Observability
SENTRY_DSN=https://public@example.ingest.sentry.io/123456
SENTRY_WORKER_DSN=https://public@example.ingest.sentry.io/123456
POSTHOG_API_KEY=phc_replace_me
POSTHOG_HOST=https://eu.i.posthog.com

# Push notifications
NOTIFICATIONS_ENABLED=true
EXPO_ACCESS_TOKEN=replace-with-expo-access-token
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
WEEKLY_JOB_DAY=0
WEEKLY_JOB_HOUR=9
WEEKLY_JOB_MINUTE=0
TASK_REMINDER_INTERVAL_MINUTES=30
TASK_REMINDER_LOOKAHEAD_MINUTES=720
JOBS_RUN_ON_STARTUP=false

# Optional
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-4.7
OPS_API_KEY=
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

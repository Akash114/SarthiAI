# Local Postgres + Redis from docker-compose (see docker-compose.yaml)
# Use hostnames `postgres` and `redis` when running API/worker via docker compose.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/Sarthi
REDIS_URL=redis://127.0.0.1:6379/0

# Required for JWT (min 32 chars in production)
JWT_SECRET=change-me-in-dev-only-use-long-secret-in-production

# Optional (defaults match app.config.Settings)
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=30

SENTRY_DSN=
# Optional: RQ worker uses this Sentry project; if unset, worker falls back to SENTRY_DSN
# SENTRY_WORKER_DSN=
# Optional: staging/production/preview — when set to a deployed value, the API/worker/scheduler
# refuse to start with the default JWT_SECRET or secrets shorter than 32 characters.
# ENVIRONMENT=staging

# Per-IP rate limit for unauthenticated /v1/auth/register|login|refresh (0 = disabled)
# AUTH_RATE_LIMIT_PER_MINUTE=30
# LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://your-collector/v1/traces
# OTEL_TRACES_SAMPLE_RATIO=1.0
# OTEL_INSTRUMENT_WITHOUT_EXPORT=false
# When true and OTLP URL unset: in-process tracing + FastAPI instrumentation (spans discarded; trace_id in logs)
# OTEL_SERVICE_NAME=sarthi-api
# OTEL_WORKER_SERVICE_NAME=sarthi-worker
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# PostHog analytics (optional — analytics disabled when unset)
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com

# Planner (optional OpenAI — otherwise heuristic planner)
# OPENAI_API_KEY=
# OPENAI_PLANNER_MODEL=gpt-4o-mini

# Push notifications (Expo). Requires httpx; set NOTIFICATIONS_ENABLED=true in environments that send.
# NOTIFICATIONS_ENABLED=false
# EXPO_ACCESS_TOKEN=   # optional; Expo push API token if using server-side auth
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# APScheduler second process (optional). Recovery jobs enqueue RQ work — run worker + Redis.
# SCHEDULER_ENABLED=false
# SCHEDULER_TIMEZONE=UTC
# WEEKLY_JOB_DAY=0
# WEEKLY_JOB_HOUR=9
# WEEKLY_JOB_MINUTE=0
# TASK_REMINDER_INTERVAL_MINUTES=30
# TASK_REMINDER_LOOKAHEAD_MINUTES=720
# JOBS_RUN_ON_STARTUP=false

# Operational HTTP triggers (optional). If unset, /v1/ops/* returns 404.
# OPS_API_KEY=

# DEBUG=false
